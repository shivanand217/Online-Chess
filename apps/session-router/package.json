{
  "//": "Session router: maps gameId to its game server via consistent hashing over etcd membership.",
  "name": "@chess/session-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ring": "./src/ring.ts",
    "./routes": "./src/routes.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@chess/config": "workspace:*",
    "@chess/registry": "workspace:*",
    "@chess/telemetry": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "testcontainers": "^10.16.0"
  }
}
