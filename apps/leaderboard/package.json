{
  "//": "Leaderboard: idempotent ELO apply on game end + rank/top-N reads (Redis sorted set).",
  "name": "@chess/leaderboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./apply": "./src/apply.ts",
    "./sweeper": "./src/sweeper.ts",
    "./reconcile": "./src/reconcile.ts",
    "./keys": "./src/keys.ts",
    "./routes": "./src/routes.ts"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/tracing.ts src/index.ts",
    "build": "tsup",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@chess/config": "workspace:*",
    "@chess/db": "workspace:*",
    "@chess/domain": "workspace:*",
    "@chess/redis": "workspace:*",
    "@chess/telemetry": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "testcontainers": "^10.16.0"
  }
}
