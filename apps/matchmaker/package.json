{
  "//": "Matchmaker worker: finds + atomically claims opponents from the Redis pool. Phase 2 adds the sorted-set pool, Lua ZREM claim, and widening-window search. Hand-written.",
  "name": "@chess/matchmaker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
