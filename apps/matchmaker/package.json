{
  "//": "Matchmaker: Redis sorted-set pool + Lua atomic claim + widening-window search.",
  "name": "@chess/matchmaker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routes": "./src/routes.ts",
    "./loop": "./src/loop.ts",
    "./notify": "./src/notify.ts",
    "./claim": "./src/claim.ts"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/tracing.ts src/index.ts",
    "build": "tsup",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/mm-smoke.ts"
  },
  "dependencies": {
    "@chess/config": "workspace:*",
    "@chess/db": "workspace:*",
    "@chess/domain": "workspace:*",
    "@chess/protocol": "workspace:*",
    "@chess/redis": "workspace:*",
    "@chess/telemetry": "workspace:*",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "testcontainers": "^10.16.0"
  }
}
