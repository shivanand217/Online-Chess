{
  "//": "API gateway: REST edge (auth, matchmaking long-poll, leaderboard reads).",
  "name": "@chess/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@chess/config": "workspace:*",
    "@chess/db": "workspace:*",
    "@chess/protocol": "workspace:*",
    "@chess/redis": "workspace:*",
    "@chess/telemetry": "workspace:*",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@chess/matchmaker": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "testcontainers": "^10.16.0"
  }
}
