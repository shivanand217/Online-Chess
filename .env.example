# Template for local environment variables — copy to `.env` and adjust. Hand-written.
# `.env` itself is git-ignored; these defaults match the docker-compose stack.

NODE_ENV=development
LOG_LEVEL=info

# Per-service HTTP ports (health/metrics; real routes land in later phases)
GATEWAY_PORT=3000
MATCHMAKER_PORT=3001
SESSION_ROUTER_PORT=3002
GAME_SERVER_PORT=3003
LEADERBOARD_PORT=3004

# Backing services (see infra/compose/docker-compose.yml)
DATABASE_URL=postgres://chess:chess@localhost:5432/chess
REDIS_URL=redis://localhost:6379
ETCD_HOSTS=http://localhost:2379
