{
  "uid": "chess-game-server",
  "title": "Chess — Game Server",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Active games",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [{ "expr": "sum(game_server_active_games)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Live WS connections",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [{ "expr": "sum(game_server_live_connections)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Moves / s (by outcome)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (result) (rate(game_server_moves_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Move latency (persist + broadcast) p50 / p99",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(game_server_move_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "game_server_move_latency_seconds:p99",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RTT credit (ms / s)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(game_server_rtt_credit_ms_total[5m])",
          "legendFormat": "credit ms/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Move latency distribution",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (le) (rate(game_server_move_latency_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    }
  ]
}
