{
  "//": "Postgres access layer (Drizzle over node-postgres): schema, drizzle-kit migrations, pooled connection, and the generation-guarded move+clock write.",
  "name": "@chess/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1"
  }
}
