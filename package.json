{
  "//": "Root workspace manifest for the chess monorepo (pnpm + Turborepo): shared dev tooling + top-level scripts. Hand-written; deps bump over time.",
  "name": "chess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "docker compose -f infra/compose/docker-compose.yml up -d && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stack:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "stack:up:obs": "docker compose -f infra/compose/docker-compose.yml --profile observability up -d",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml down",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "lefthook": "^1.10.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
